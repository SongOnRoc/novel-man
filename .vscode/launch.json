{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "backend",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "args": ["api"],
      "program": "${workspaceFolder}/backend/main.go",
      "output": "${workspaceFolder}/backend/server.exe"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "console": "internalConsole",
      "cwd": "${workspaceFolder}/frontend"
    }
  ]
}
