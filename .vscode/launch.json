{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "backend",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "args": ["api"],
      "program": "${workspaceFolder}/backend/main.go",
      "output": "${workspaceFolder}/backend/server.exe"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "novel",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "skipFiles": ["<node_internals>/**"],
      "console": "internalConsole",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "outFiles": ["${workspaceFolder}/.next/**/*.js"]
    }
  ]
}
